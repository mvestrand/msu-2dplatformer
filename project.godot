[layer_names]

2d_physics/layer_1="solid"
2d_physics/layer_2="passthrough"
2d_physics/layer_3="hitbox"
2d_physics/layer_4="dmgbox"
2d_physics/layer_5="checkpoint"
2d_physics/layer_6="pickup"
2d_physics/layer_7="feet"
2d_physics/layer_8="head"
2d_physics/layer_9="door_check"

[mono]

runtime/unhandled_exception_policy=1
project/assembly_name="MSU_2DPlatformer"

[physics]

common/enable_pause_aware_picking=true
2d/default_gravity=980

[rendering]

quality/driver/driver_name="GLES2"
2d/snapping/use_gpu_pixel_snap=true
vram_compression/import_etc=true
vram_compression/import_etc2=false
2d/options/ninepatch_mode=0
environment/default_clear_color=Color( 0, 0, 0, 1 )
environment/default_environment="res://default_env.tres"
