; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

_global_script_classes=[ {
"base": "Object",
"class": "CommonControls",
"language": "GDScript",
"path": "res://addons/extendable_inspector/utils/common_controls.gd"
}, {
"base": "EditorInspectorPlugin",
"class": "ExtendableInspector",
"language": "GDScript",
"path": "res://addons/extendable_inspector/core/extendable_inspector_plugin.gd"
} ]
_global_script_class_icons={
"CommonControls": "",
"ExtendableInspector": ""
}

[application]

config/name="MSU_2DPlatformer"
run/main_scene="res://base/levels/level2.tscn"
config/icon="res://icon.png"

[debug]

shapes/collision/shape_color=Color( 0.7, 0.7, 0.7, 0.419608 )

[display]

window/size/width=1280
window/size/height=720
window/dpi/allow_hidpi=true
window/stretch/aspect="keep"

[editor_plugins]

enabled=PoolStringArray( "res://addons/extendable_inspector/plugin.cfg", "res://addons/kanban_tasks/plugin.cfg" )

[gui]

common/drop_mouse_on_gui_input_disabled=true

[importer_defaults]

texture={
"detect_3d": false,
"flags/filter": false
}

